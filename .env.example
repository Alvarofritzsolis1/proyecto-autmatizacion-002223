# Copiar como .env SOLO EN EL VPS y ejecutar chmod 600 .env
# El dominio debe tener un registro DNS A hacia la IPv4 publica de Contabo.
GALANT_DOMAIN=galant.example.com
GALANT_USER=auditor
# Generar con: sudo docker run --rm -it caddy:2-alpine caddy hash-password
# Copiar el hash completo ENTRE COMILLAS SIMPLES para no interpolar los $.
GALANT_AUTH_HASH='$2a$14$REEMPLAZAR_POR_HASH_REAL_DE_CADDY'
